#lang ivy1.7
# check with ivy_check isolate=abstract_protocol seed=$RANDOM complete=fo constant_space_unauth.ivy

# We start with the domain model (nodes, rounds, values, quorums, blocking sets, etc.)
include order

instance node : iterable # nodes are a set with an order, that can be iterated over (see order.ivy in the standard library)

type value

instance round : unbounded_sequence # this establishes that rounds are totally ordered by < with least element 0
type quorum
type blocking # blocking sets

relation well_behaved(N:node) # NOTE: Use only in the proof! Nodes do not know that.

relation q_member(N:node, Q:quorum) # membership relation
relation b_member(N:node, B:blocking) # membership relation

trusted isolate intersection_assumptions = {
    property [quorum_intersection] exists N. well_behaved(N) & q_member(N, Q1) & q_member(N, Q2) # every two quorums have a well-behaved node in common
    property [blocking_assm] exists N . well_behaved(N) & b_member(N,B) # every blocking set contains a well-behaved node
}

isolate abstract_protocol = {

    relation left_round(N:node, R:round)
    relation proposal(R:round, V:value)
    relation key_1(N:node, R:round, V:value)
    relation key_2(N:node, R:round, V:value)
    relation key_3(N:node, R:round, V:value)
    relation vote(N:node, R:round, V:value)
    relation decided(N:node, R:round, V:value)

    after init {
        proposal(R,V) := false;
        key_1(N,R,V) := false;
        key_2(N,R,V) := false;
        key_3(N,R,V) := false;
        vote(N,R,V) := false;
        decided(N,R,V) := false;
        left_round(N,R) := false;
    }

    export action join_round(n:node, r:round) = {
        require ~left_round(n,r);
        left_round(n,R) := R < r;
    }

    relation temp(N:node, R:round, V:value) # we'll use this as a temporary variable
    relation temp_2(N:node, R:round, V:value) # we'll use this as a temporary variable

    relation claims_safe_at(N:node, R:round, V:value)
    definition claims_safe_at(N:node, r:round, v:value) =
        exists R1 . R1 >= r & ( # temp is e.g. a copy of key_1
                temp(N,R1,v)
            |   exists R2,V1,V2 . R1 < R2 & temp(N,R1,V1) & temp(N,R2,V2) & V1 ~= V1 # everything is safe at R1
        )
    # NOTE: we only need two things to compute claims_safe_at: the highest temp round and value, and the second highest temp round

    relation shows_safe_at(R1:round, R2:round, V:value, Q:quorum, B:blocking)
    definition shows_safe_at(r1:round, r2:round, v:value, q:quorum, b:blocking) =
        # q and b show that v is safe at r2, meaning nothing but v is choosable at a round r such that r < r2
        # r1 is the max round r1 < r2 in which q voted, if any
        (forall N,R . q_member(N,q) & R < r2 -> left_round(N,r2))
    &
        (
            (       r1 < r2
                &   (forall N . b_member(N,b) -> claims_safe_at(N,r1,v)) # v is safe at r1
                &   (forall N,V . q_member(N,q) & temp_2(N,r1,V) -> V = v) # only v voted for at r1, if any, among q
                &   (forall N,R,V . q_member(N,q) & r1 < R & R < r2 -> ~temp_2(N,R,V)) ) # no vote among q after r1
        |
            (   forall N,R,V . q_member(N,q) & R < r2 -> ~temp_2(N,R,V) ) ) # nobody ever voted before r2

    export action do_key_1(n:node, r:round, v:value) = {
        require ~key_1(n,r,V) & ~left_round(n,r);
        # non-leaders use key_1 and vote to determine what is safe:
        temp(N,R,V) := key_1(N,R,V);
        temp_2(N,R,V) := vote(N,R,V);
        require exists R,Q,B . shows_safe_at(R, r, v, Q, B);
        key_1(n, r, v) := true;
        left_round(n, R) := R < r;
    }

    export action do_key_2(n:node, r:round, v:value) = {
        require ~key_2(n,r,V) & ~left_round(n,r);
        require exists Q . q_member(N,Q) -> key_1(N,r,v);
        key_2(n, r, v) := true;
        left_round(n, R) := R < r;
    }

    export action do_key_3(n:node, r:round, v:value) = {
        require ~key_3(n,r,V) & ~left_round(n,r);
        require exists Q . q_member(N,Q) -> key_2(N,r,v);
        key_3(n, r, v) := true;
        left_round(n, R) := R < r;
    }

    export action do_vote(n:node, r:round, v:value) = {
        require ~vote(n,r,V) & ~left_round(n,r);
        require exists Q . q_member(N,Q) -> key_3(N,r,v);
        vote(n, r, v) := true;
        left_round(n, R) := R < r;
    }

    export action decide(n:node, r:round, v:value, q:quorum) = {
        require q_member(N, q) -> vote(N, r, v);
        decided(n, r, v) := true;
    }

    export action propose(r:round, v:value, q:quorum, r1:round) = {
        # leaders use key_2 and key_3 to determine what is safe:
        temp(N,R,V) := key_2(N,R,V);
        temp_2(N,R,V) := key_3(N,R,V);
        require exists R,Q,B . shows_safe_at(R, r, v, Q, B);
        proposal(r,v) := true;
        assert safe_at(r,v);
    }

    # notion of choosable and safe at:
    ##################################
    relation choosable(R:round, V:value)
    definition [choosable_def] choosable(R,V) = exists Q . forall N . well_behaved(N) & q_member(N,Q) -> ~left_round(N,R) | vote(N,R,V)
    relation safe_at(R:round, V:value)
    definition [safe_at_def] safe_at(R2,V2) = forall R1,V1 . R1 < R2 & V1 ~= V2 -> ~choosable(R1,V1)

    # the agreement property:
    # #####################
    invariant [safety] well_behaved(N1) & well_behaved(N2) & decided(N1,R1,V1) & decided(N2,R2,V2) -> V1 = V2

    invariant well_behaved(N) & key_1(N,R,V) -> safe_at(R,V)
    invariant well_behaved(N) & key_2(N,R,V) -> safe_at(R,V)
    invariant well_behaved(N) & key_3(N,R,V) -> safe_at(R,V)
    invariant well_behaved(N) & vote(N,R,V) -> safe_at(R,V)
invariant (exists N1 . well_behaved(N1) & decided(N1,R,V)) -> exists Q. forall N2. well_behaved(N2) & q_member(N2, Q) -> vote(N2,R,V)
    invariant (exists N1 . well_behaved(N1) & vote(N1,R,V)) -> exists Q. forall N2. well_behaved(N2) & q_member(N2, Q) -> key_3(N2,R,V)
    invariant (exists N1 . well_behaved(N1) & key_3(N1,R,V)) -> exists Q. forall N2. well_behaved(N2) & q_member(N2, Q) -> key_2(N2,R,V)
    invariant (exists N1 . well_behaved(N1) & key_2(N1,R,V)) -> exists Q. forall N2. well_behaved(N2) & q_member(N2, Q) -> key_1(N2,R,V)

    # now, supporting invariants:
    #############################

    # if a node left round R2>R1, then it also left R1
    invariant well_behaved(N) & left_round(N,R2) & R1 < R2 -> left_round(N,R1)

    # nodes stop preparing or committing in lower rounds when doing so in a higher round:
    invariant well_behaved(N) & key_1(N,R2,V2) & R1 < R2 -> left_round(N,R1)
    invariant well_behaved(N) & key_2(N,R2,V2) & R1 < R2 -> left_round(N,R1)
    invariant well_behaved(N) & key_3(N,R2,V2) & R1 < R2 -> left_round(N,R1)
    invariant well_behaved(N) & vote(N,R2,V2) & R1 < R2 -> left_round(N,R1)

    invariant well_behaved(N) & key_1(N,R,V) & key_1(N,R,V2) -> V = V2
    invariant well_behaved(N) & key_2(N,R,V) & key_2(N,R,V2) -> V = V2
    invariant well_behaved(N) & key_3(N,R,V) & key_3(N,R,V2) -> V = V2
    invariant well_behaved(N) & vote(N,R,V) & vote(N,R,V2) -> V = V2


} with round, intersection_assumptions

# Concrete protocol model

object pair_opt_t = {
    type this
    individual rnd : round
    individual val : value
    individual present: bool
}

object round_opt_t = {
    type this
    individual rnd : round
    individual present: bool
}

type msg

object proposal_msg = {
    variant this of msg = struct {
        src : node,
        rnd : round,
        val : value
    }
}

object suggest_msg = {
    variant this of msg = struct {
        src : node,
        key_2 : pair_opt_t,
        prev_key2 : round_opt_t,
        key3 : pair_opt_t,
        val : value
    }
}

object proof_msg = {
    variant this of msg = struct {
        src : node,
        vote : pair_opt_t,
        key1 : pair_opt_t
    }
}

object key_1_msg = {
    variant this of msg = struct {
        src : node,
        rnd : round,
        val : value
    }
}

object key_2_msg = {
    variant this of msg = struct {
        src : node,
        rnd : round,
        val : value
    }
}

object key_3_msg = {
    variant this of msg = struct {
        src : node,
        rnd : round,
        val : value
    }
}

object vote_msg = {
    variant this of msg = struct {
        src : node,
        rnd : round,
        val : value
    }
}

type phase_t = {suggest_phase, key_1_phase, key_2_phase, key_3_phase, vote_phase}

isolate protocol = {

    object server(n:node) = {

