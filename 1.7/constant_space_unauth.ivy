        relation highest_prev_key_2(N:node, R:round)

        # state used by a non-leader leader to determine what values are safe the current round:
        relation highest_key_1(N:node, R:round, V:value)
        relation highest_prev_key_1(N:node, R:round)


        after init {
            # call reset_round_state; TODO: BUG: seems we can't call anything in init
            rnd := 0;
            vote.present := false;
            key_3.present := false;
            key_2.present := false;
            key_1.present := false;
            decided := false;
            phase := suggest_phase;
            key_3s(N,V) := false;
            key_2s(N,V) := false;
            key_1s(N,V) := false;
            votes(N,V) := false;
            joined(N) := false;
            highest_vote(N,R,V) := false;
            highest_key_2(N,R,V) := false;
            highest_prev_key_2(N,R) := false;
            highest_key_1(N,R,V) := false;
            highest_prev_key_1(N,R) := false;
        }

        action reset_round_state = {
            phase := suggest_phase;
            key_3s(N,V) := false;
            key_2s(N,V) := false;
            key_1s(N,V) := false;
            votes(N,V) := false;
            joined(N) := false;
            highest_vote(N,R,V) := false;
            highest_key_2(N,R,V) := false;
            highest_prev_key_2(N,R) := false;
            highest_key_1(N,R,V) := false;
            highest_prev_key_1(N,R) := false;
        }

        # a leader starts a new round:
        export action start_round(r:round) = {
            require r > rnd;
            rnd := r;

            call reset_round_state;

            if proposers.is_proposer(n,r) {
                joined(N) := N = n;
            }
            else {
                # var m:start_round_msg;
                # m.src := n;
                # m.rnd := r;
                # m.voted := voted;
                # m.last_vote_rnd := last_vote_rnd;
